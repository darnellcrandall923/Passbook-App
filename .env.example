# Copy this file to .env and fill in your own Supabase project's values.
# Find these in your Supabase project: Settings -> API.
# Both are safe to expose in client-side code — access control is
# enforced by row-level security policies in supabase/schema.sql, not
# by keeping these secret.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
